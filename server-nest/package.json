{
  "name": "gamer-server-nest",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS online-game backend skeleton for Gamer.",
  "scripts": {
    "build": "nest build",
    "schema:init": "node dist/database/bootstrap-schema.js",
    "start:render": "node dist/database/bootstrap-schema.js && node dist/main.js",
    "e2e:http": "node scripts/e2e-http.mjs",
    "e2e:online-loop": "node scripts/e2e-online-loop.mjs",
    "e2e:workshop-loop": "node scripts/e2e-workshop-loop.mjs",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.48.0"
  }
}
