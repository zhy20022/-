{$API_DOMAIN_NAME} {
  encode zstd gzip

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }

  @online path /api/* /socket.io/*
  reverse_proxy @online api:4100

  respond /health "Gamer public API gateway is running" 200

  respond 404
}
