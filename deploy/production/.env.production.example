# Copy this file to .env.production and change every secret before going online.

DOMAIN_NAME=example.com
ACME_EMAIL=admin@example.com

POSTGRES_DB=gamer_online
POSTGRES_USER=gamer
POSTGRES_PASSWORD=change-this-postgres-password

DATABASE_URL=postgres://gamer:change-this-postgres-password@postgres:5432/gamer_online
REDIS_URL=redis://redis:6379

NODE_ENV=production
PORT=4100
JWT_SECRET=change-this-long-random-jwt-secret
AUTH_TOKEN_SECRET=change-this-long-random-online-auth-token-secret
ADMIN_TOKEN=change-this-long-random-admin-token
BACKUP_TOKEN=change-this-separate-long-random-backup-token
CONTENT_DIR=/workspace/data/content
CORS_ORIGIN=https://example.com

VITE_ONLINE_API_URL=https://example.com
VITE_SOCKET_URL=https://example.com

# Production schema changes are applied by the versioned migration runner.
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false
ALLOW_GUEST_LOGIN=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT_MS=10000
TRUST_PROXY_HOPS=1
REQUEST_BODY_LIMIT=256kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
